    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^27.0.1",
    "prettier": "^3.9.9",
    "vite": "^8.3.0",
    "vitest": "^3.2.7"
  }
}
